// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// ENUMS
// ===========================================

enum UserType {
  INFLUENCER
  BRAND
  AGENCY
  ADMIN
}

enum BrandVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
  COMPLETED
}

enum CompensationType {
  PAID
  GIFTED
  PAID_PLUS_GIFT
  AFFILIATE
  NEGOTIABLE
}

enum ContentType {
  IMAGE_POST
  VIDEO
  STORY
  REEL
  ANY
}

enum AlertFrequency {
  INSTANT
  DAILY
  WEEKLY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  HELD
  RELEASE_PENDING
  RELEASED
  PAYOUT_PROCESSING
  PAID
  REFUNDED
  DISPUTED
  FAILED
}

enum CollaborationStatus {
  AWAITING_CONFIRMATION
  ACTIVE
  SUBMITTED
  COMPLETED
  CANCELLED
}

enum SubscriptionTier {
  FREE
  PRO
}

// ===========================================
// MULTILINGUAL SUPPORT
// ===========================================

model Translation {
  id               String   @id @default(cuid())
  entityType       String   // "Campaign", "InfluencerProfile", "BrandProfile"
  entityId         String   // ID of the translated entity
  fieldName        String   // "title", "description", "bio", etc.
  languageCode     String   // "en", "zh", "es", etc.
  content          String   @db.Text
  isAutoTranslated Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([entityType, entityId, fieldName, languageCode])
  @@index([entityType, entityId])
  @@index([languageCode])
  @@map("translations")
}

// ===========================================
// USERS & AUTHENTICATION
// ===========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  userType         UserType         @default(INFLUENCER)
  // Workspace view for ADMIN accounts ('BRAND' | 'INFLUENCER'); admins keep
  // userType=ADMIN and switch views via this field instead. Null = brand view.
  activeView       String?
  subscriptionTier SubscriptionTier @default(FREE)
  // Set when PRO was granted as a limited verified-user trial (early-stage
  // promo); null for paid PRO. Lazily downgraded once expired.
  proTrialEndsAt   DateTime?
  preferredLanguage  String   @default("en")
  autoTranslateUGC   Boolean  @default(true)
  // Stamped once the mandatory first-login Language & Region setup is done
  languageSetupAt    DateTime?
  colorTheme         String   @default("default")
  preferredContentLanguage String?
  timeZone                 String?
  dateFormat               String  @default("MM/DD/YYYY")
  displayCurrency          String  @default("USD")
  defaultCampaignCurrency  String  @default("USD")
  emailNotifications       Boolean @default(true)
  emailCampaignUpdates        Boolean @default(true)
  emailCollaborationUpdates   Boolean @default(true)
  emailPaymentUpdates         Boolean @default(true)
  emailProductUpdates         Boolean @default(true)
  profileDiscoverable         Boolean @default(true)
  allowContactSharing         Boolean @default(true)
  allowBusinessContactSharing Boolean @default(true)
  isVerified    Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts          Account[]
  sessions          Session[]
  savedSearches     SavedSearch[]
  influencerProfile InfluencerProfile?
  brandProfile      BrandProfile?
  agencyProfile     AgencyProfile?
  aiTokenUsage      AiTokenUsage[]
  betaFeedback      BetaFeedback[]
  aiChats           AiChat[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ===========================================
// LOOKUP TABLES
// ===========================================

model Category {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  slug         String  @unique
  iconUrl      String?
  parentId     Int?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  parent             Category?          @relation("CategoryToCategory", fields: [parentId], references: [id])
  children           Category[]         @relation("CategoryToCategory")
  campaignCategories CampaignCategory[]

  @@map("categories")
}

model Platform {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  slug     String  @unique
  iconUrl  String?
  isActive Boolean @default(true)

  socialAccounts              InfluencerSocialAccount[]
  campaignPlatforms           CampaignPlatform[]
  campaignFollowerRequirements CampaignFollowerRequirement[]

  @@map("platforms")
}

// ===========================================
// INFLUENCER PROFILES
// ===========================================

model InfluencerProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  originalLanguage String    @default("en")
  displayName      String?
  avatarUrl        String?
  bio              String?   @db.Text
  locationCity     String?
  locationState    String?
  locationCountry  String?   @default("USA")
  primaryNiche     String?
  secondaryNiches  String[]
  languages        String[]
  // 'gifted' | 'paid' | 'performance'
  preferredCollabTypes String[] @default([])
  isVerified       Boolean   @default(false)
  verificationDate DateTime?
  stripeConnectId          String?
  stripeOnboardingComplete Boolean @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialAccounts  InfluencerSocialAccount[]
  applications    Application[]
  savedCampaigns  SavedCampaign[]
  collaborations  Collaboration[]
  savedByBrands   SavedCreator[]

  @@map("influencer_profiles")
}

model InfluencerSocialAccount {
  id                 String    @id @default(cuid())
  influencerId       String
  platformId         Int
  username           String
  profileUrl         String?
  followerCount      Int       @default(0)
  likesCount         Int?
  engagementRate     Decimal?  @db.Decimal(5, 2)
  isVerified         Boolean   @default(false)
  verificationMethod String?   // "url" | "screenshot" | "manual"
  screenshotUrl      String?
  verifiedAt         DateTime?
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  influencer   InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  platform     Platform          @relation(fields: [platformId], references: [id])
  applications Application[]

  @@unique([influencerId, platformId])
  @@map("influencer_social_accounts")
}

// ===========================================
// BRAND PROFILES
// ===========================================

model BrandProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  originalLanguage String    @default("en")
  companyName      String?
  logoUrl          String?
  websiteUrl       String?
  storeUrl         String?
  description      String?   @db.Text
  industry         String?
  // Public-profile multi-selects (industry kept for legacy single value)
  countries        String[]  @default([])
  industries       String[]  @default([])
  socialLinks      String[]  @default([])
  companySize      String?   // 'startup', 'small', 'medium', 'enterprise'
  // 'brand' | 'agency' | 'individual_pr' — locked once verified
  accountType      String?
  contactName      String?
  contactJobTitle  String?
  contactEmail     String?
  contactPhone     String?
  isVerified       Boolean   @default(false)
  verificationDate DateTime?

  // Brand verification workflow
  brandVerificationStatus BrandVerificationStatus @default(PENDING)
  verificationSubmittedAt DateTime?
  verificationReviewedAt  DateTime?
  verificationReviewedBy  String?
  rejectionReason         String?        @db.Text

  // Business verification info
  businessLegalName       String?
  businessRegistrationNo  String?
  businessCountry         String?
  businessWebsite         String?
  businessDocuments       String[]       @default([])
  // Full structured verification submission (per account type + country flow)
  verificationData        Json?

  stripeCustomerId    String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  collaborations Collaboration[]
  savedCreators  SavedCreator[]

  @@map("brand_profiles")
}

// ===========================================
// AGENCY PROFILES
// ===========================================

model AgencyProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  agencyName   String
  logoUrl      String?
  websiteUrl   String?
  description  String?  @db.Text
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@map("agency_profiles")
}

// ===========================================
// CAMPAIGNS
// ===========================================

model Campaign {
  id               String         @id @default(cuid())
  brandId          String
  agencyId         String?
  originalLanguage String         @default("en")

  // Basic Info
  title            String
  description      String?        @db.Text

  // Status & Dates
  status           CampaignStatus @default(DRAFT)
  publishedAt      DateTime?
  deadline         DateTime?
  campaignStartDate DateTime?
  campaignEndDate  DateTime?

  // Slots & Applications
  totalSlots       Int            @default(10)
  filledSlots      Int            @default(0)

  // Compensation
  compensationType CompensationType
  paymentMin       Decimal?       @db.Decimal(10, 2)
  paymentMax       Decimal?       @db.Decimal(10, 2)
  giftDescription  String?
  giftValue        Decimal?       @db.Decimal(10, 2)

  // Requirements
  requiresProductPurchase Boolean @default(false)
  productPurchaseAmount   Decimal? @db.Decimal(10, 2)
  isProductReimbursed     Boolean @default(false)

  // Content Requirements
  contentType      ContentType?
  contentGuidelines String?       @db.Text
  wordCountMin     Int?
  wordCountMax     Int?
  hashtagsRequired String?
  mentionsRequired String?

  // Media
  images           String[]

  // Overseed campaign review: set when review requests changes
  // (PENDING_REVIEW → DRAFT); cleared on resubmission.
  reviewNote       String?        @db.Text

  // Visibility & Discovery
  isFeatured       Boolean        @default(false)
  viewCount        Int            @default(0)

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Relations
  brand                BrandProfile                  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  agency               AgencyProfile?                @relation(fields: [agencyId], references: [id])
  platforms            CampaignPlatform[]
  categories           CampaignCategory[]
  followerRequirements CampaignFollowerRequirement[]
  media                CampaignMedia[]
  applications         Application[]
  savedBy              SavedCampaign[]
  collaborations       Collaboration[]
  outreachQueue        CampaignOutreach[]

  @@index([status, createdAt])
  @@index([brandId])
  @@index([deadline])
  @@map("campaigns")
}

// Creators selected by a brand for Overseed-managed outreach. Contact details
// are deliberately not stored here or exposed to the brand workspace.
model CampaignOutreach {
  id                String   @id @default(cuid())
  campaignId        String
  externalCreatorId String
  platform          String
  handle            String?
  displayName       String?
  avatarUrl         String?
  followerCount     Int?
  engagementRate    Decimal? @db.Decimal(7, 3)
  country           String?
  nicheTags         String[] @default([])
  status            String   @default("SHORTLISTED")
  requestedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, externalCreatorId])
  @@index([campaignId, status])
  @@map("campaign_outreach")
}

// Lightweight product analytics. It intentionally stores only the signed-in
// user id and route, never search terms or creator contact information.
model PageViewEvent {
  id        String   @id @default(cuid())
  userId    String
  path      String
  createdAt DateTime @default(now())

  @@index([path, createdAt])
  @@index([userId, createdAt])
  @@map("page_view_events")
}

model CampaignPlatform {
  campaignId String
  platformId Int

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  platform Platform @relation(fields: [platformId], references: [id])

  @@id([campaignId, platformId])
  @@map("campaign_platforms")
}

model CampaignCategory {
  campaignId String
  categoryId Int

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@id([campaignId, categoryId])
  @@map("campaign_categories")
}

model CampaignFollowerRequirement {
  id                String   @id @default(cuid())
  campaignId        String
  platformId        Int
  minFollowers      Int      @default(0)
  maxFollowers      Int?
  minEngagementRate Decimal? @db.Decimal(5, 2)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  platform Platform @relation(fields: [platformId], references: [id])

  @@unique([campaignId, platformId])
  @@map("campaign_follower_requirements")
}

model CampaignMedia {
  id           String   @id @default(cuid())
  campaignId   String
  mediaUrl     String
  mediaType    String   @default("image") // 'image' or 'video'
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("campaign_media")
}

// ===========================================
// APPLICATIONS
// ===========================================

model Application {
  id               String            @id @default(cuid())
  campaignId       String
  influencerId     String
  socialAccountId  String?
  status           ApplicationStatus @default(PENDING)
  pitchMessage     String?           @db.Text
  proposedRate     Decimal?          @db.Decimal(10, 2)
  brandNotes       String?           @db.Text
  rejectionReason  String?
  appliedAt        DateTime          @default(now())
  reviewedAt       DateTime?
  approvedAt       DateTime?
  completedAt      DateTime?
  updatedAt        DateTime          @updatedAt

  // Relations
  campaign      Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencer    InfluencerProfile        @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  socialAccount InfluencerSocialAccount? @relation(fields: [socialAccountId], references: [id])
  conversation  Conversation?
  payment       Payment?
  collaboration Collaboration?

  @@unique([campaignId, influencerId])
  @@index([influencerId, status])
  @@index([campaignId, status])
  @@map("applications")
}

// ===========================================
// MESSAGING
// ===========================================

model Conversation {
  id            String   @id @default(cuid())
  applicationId String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages      Message[]
  participants  ConversationParticipant[]

  @@index([updatedAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  senderId        String
  content         String   @db.Text
  messageType     String   @default("text")
  attachmentUrl   String?
  attachmentName  String?
  attachmentMime  String?
  isSystemMessage Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// ===========================================
// AI TOKEN USAGE
// ===========================================

model AiTokenUsage {
  id               String   @id @default(cuid())
  userId           String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  model            String
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_token_usage")
}

// ===========================================
// BETA TEST
// ===========================================

model BetaInviteCode {
  id        String   @id @default(cuid())
  code      String   @unique
  note      String?  // Admin note about who this code is for
  maxUses   Int      @default(1)
  usedCount Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  expiresAt DateTime?

  usedBy    BetaInviteUsage[]

  @@index([code])
  @@map("beta_invite_codes")
}

model BetaInviteUsage {
  id           String   @id @default(cuid())
  inviteCodeId String
  userId       String
  usedAt       DateTime @default(now())

  inviteCode BetaInviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)

  @@unique([inviteCodeId, userId])
  @@map("beta_invite_usage")
}

model BetaFeedback {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "bug", "feature", "general"
  content   String   @db.Text
  page      String?  // URL where feedback was submitted
  status    String   @default("new") // "new", "reviewed", "resolved"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("beta_feedback")
}

// ===========================================
// AI CHAT HISTORY
// ===========================================

model AiChat {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New Chat")
  provider  String   @default("openai") // "openai" or "claude"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiChatMessage[]

  @@index([userId])
  @@map("ai_chats")
}

model AiChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  role      String   // "user" or "assistant"
  content   String   @db.Text
  feedback  String?  // "like" or "dislike" — only for assistant messages
  createdAt DateTime @default(now())

  chat AiChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@map("ai_chat_messages")
}

// ===========================================
// SAVED CAMPAIGNS & SEARCHES
// ===========================================

// Brand-side bookmarks of platform creators ("Saved Creators")
model SavedCreator {
  brandId      String
  influencerId String
  savedAt      DateTime @default(now())

  brand      BrandProfile      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  influencer InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@id([brandId, influencerId])
  @@index([influencerId])
  @@map("saved_creators")
}

model SavedCampaign {
  influencerId String
  campaignId   String
  savedAt      DateTime @default(now())

  influencer InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  campaign   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([influencerId, campaignId])
  @@map("saved_campaigns")
}

model SavedSearch {
  id         String         @id @default(cuid())
  userId     String
  name       String
  filters    Json
  frequency  AlertFrequency @default(INSTANT)
  isActive   Boolean        @default(true)
  lastSentAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_searches")
}

// ===========================================
// PAYMENTS
// ===========================================

model Payment {
  id                    String        @id @default(cuid())
  // A payment belongs to a Collaboration (the funded unit of work). applicationId
  // is retained, nullable, only for legacy rows created before Collaborations
  // existed; new payments set collaborationId.
  applicationId         String?       @unique
  collaborationId       String?       @unique
  amount                Decimal       @db.Decimal(10, 2)
  platformFee           Decimal       @db.Decimal(10, 2)
  creatorPayout         Decimal       @db.Decimal(10, 2)
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String?       @unique
  stripeTransferId      String?
  stripeRefundId        String?
  paidAt                DateTime?
  releasedAt            DateTime?
  refundedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  application           Application?   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  collaboration         Collaboration? @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}

// ===========================================
// COLLABORATIONS
// ===========================================

model Collaboration {
  id             String              @id @default(cuid())
  campaignId     String
  applicationId  String              @unique
  influencerId   String
  brandId        String
  status         CollaborationStatus @default(AWAITING_CONFIRMATION)

  // Locked terms — frozen when the creator accepts the collaboration
  deliverables        String?  @db.Text
  fee                 Decimal? @db.Decimal(10, 2)
  currency            String   @default("USD")
  productCompensation String?
  deadline            DateTime?
  revisionRounds      Int      @default(2)
  revisionsUsed       Int      @default(0)
  usageRights         String?  @db.Text
  termsLockedAt       DateTime?

  // Published evidence submitted by the creator
  publishedUrl        String?
  publishedPlatform   String?
  publishedAt         DateTime?
  evidenceScreenshot  String?

  // Lifecycle timestamps
  confirmedAt    DateTime?
  submittedAt    DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  disputedAt     DateTime?
  reviewNote     String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  campaign         Campaign                   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  application      Application                @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  influencer       InfluencerProfile          @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  brand            BrandProfile               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  deliverableItems CollaborationDeliverable[]
  payment          Payment?

  @@index([brandId, status])
  @@index([influencerId, status])
  @@index([campaignId])
  @@map("collaborations")
}

model CollaborationDeliverable {
  id              String    @id @default(cuid())
  collaborationId String
  title           String
  type            String    @default("other") // video | image | story | other
  status          String    @default("pending") // pending | submitted | approved | revision_requested
  fileUrl         String?
  note            String?   @db.Text
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@index([collaborationId])
  @@map("collaboration_deliverables")
}
