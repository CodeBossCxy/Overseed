# Creator Discovery Experiment - API Configuration
# Copy this file to .env.discovery and fill in your keys

# Serper.dev — Google Search API ($0.001/query, 2500 free on signup)
# Sign up: https://serper.dev
SERPER_API_KEY=

# Optional: override search provider (serper | mock)
# Default: serper if SERPER_API_KEY is set, otherwise mock
SEARCH_PROVIDER=

# Optional: max concurrent search requests (default: 3)
MAX_CONCURRENCY=3

# Optional: delay between search requests in ms (default: 500)
REQUEST_DELAY_MS=500
